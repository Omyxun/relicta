# Application & Security
APP_NAME="BazarSentinel"
SECRET_KEY="change-this-to-a-64-char-random-hex-string-in-production"
ALLOW_REGISTRATION=true
LOG_LEVEL="INFO"

# Database (stored inside the mounted /app/data volume for WAL support)
DATABASE_URL="sqlite+aiosqlite:///./data/sentinel.db"

# Scraper & Scheduler Defaults
DEFAULT_BASE_CURRENCY="CZK"
SCRAPER_REQUEST_TIMEOUT_SECONDS=20.0
SCRAPER_MIN_DELAY_SECONDS=3.0
SCRAPER_MAX_DELAY_SECONDS=7.0
SCHEDULER_JITTER_SECONDS=45
MAX_CONSECUTIVE_FAILURES=5
SEEN_LISTINGS_RETENTION_DAYS=45

# eBay Official Browse API (OAuth2 Client Credentials)
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
EBAY_MARKETPLACE_ID="EBAY_DE"
EBAY_DEFAULT_SHIP_TO_COUNTRY="CZ"

# Shared / Fallback Notification Credentials
TELEGRAM_DEFAULT_BOT_TOKEN=""
NTFY_DEFAULT_SERVER_URL="https://ntfy.sh"

# SMTP Relay Configuration for Email Digests
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="alerts@localhost"
SMTP_USE_TLS=true